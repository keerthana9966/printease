# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/printease?retryWrites=true&w=majority

# Optional: local MongoDB URI (used as fallback)
MONGODB_LOCAL=mongodb://127.0.0.1:27017/printease

# JWT secret key (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Cloudinary credentials (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vendor invite code — vendors need this to register
VENDOR_INVITE_CODE=VENDOR2024

# Server port (default: 5000)
PORT=5000
